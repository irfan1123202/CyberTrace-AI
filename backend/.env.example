# CyberTrace AI — Backend Environment Variables
# Copy this file to .env and fill in values

# ─── SERVER ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── IP GEOLOCATION APIs ───────────────────────────────────────────
# ip-api.com (free tier, 45 req/min — no key needed for HTTP)
GEOIP_API_BASE=http://ip-api.com/json
GEOIP_API_FIELDS=status,message,country,countryCode,region,regionName,city,lat,lon,timezone,isp,org,as,asname,reverse,mobile,proxy,hosting,query

# ipinfo.io (free 50k/month — add your token here)
IPINFO_TOKEN=

# AbuseIPDB (threat reputation — register free at abuseipdb.com)
ABUSEIPDB_API_KEY=

# VirusTotal (URL & domain scanning — register free)
VIRUSTOTAL_API_KEY=

# ─── GOOGLE MAPS (optional for frontend embedding) ─────────────────
GOOGLE_MAPS_API_KEY=

# ─── RATE LIMITS ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ─── CORS ALLOWED ORIGINS ──────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
